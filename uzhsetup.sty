\ProvidesPackage{uzhsetup}

\RequirePackage{ifthen}
\RequirePackage{calc}
\RequirePackage{tikz}
\RequirePackage[english]{babel}
\RequirePackage{varwidth}

\def\uzh@de{de}
\def\uzh@en{en}
\let\uzh@language\uzh@en

\newcommand{\uzh@uzh}{%
  \ifx\uzh@language\uzh@de Universität Zürich%
  \else University of Zurich\fi%
}

% Purpose of the talk -- "1st Committee Meeting", "Doctoral Defence", ... Set it
% in the preamble like \title or \author:
%   \occasion{1st Committee Meeting}
% It appears in the footline just left of the date; leave it unset and the
% footline looks exactly as before.
\newcommand{\uzh@occasion}{}
\newcommand{\occasion}[1]{\renewcommand{\uzh@occasion}{#1}}
\newcommand{\insertoccasion}{\uzh@occasion}

% Superscript for names such as DM^3L. It reproduces the geometry the DM3L
% website gives to <sup> in "DM<sup>3</sup>L", so the printed name matches
% https://dm3l.uzh.ch. The site inherits Bootstrap's reboot rule
%
%   sub,sup { font-size: 75%; line-height: 0; position: relative;
%             vertical-align: baseline; }
%   sup     { top: -.5em; }
%
% and it sets the same typeface the theme uses, Source Sans Pro, so the two
% render alike. Both numbers below are therefore fractions of 1 em of the
% SURROUNDING text: \uzh@supscale is the CSS font-size, and \uzh@supraise is the
% CSS top -- halved again, because a CSS em resolves against the element's own
% font size, which the 75% rule has already reduced (0.5 x 0.75 = 0.375).
%
% Working in em also keeps one macro right at every size, from the 5pt footline
% to the title. \textsuperscript cannot do this: it uses the fixed math-script
% size \sf@size and a math-mode rise, which put the digit both larger and higher
% than the website does.
\def\uzh@supscale{0.75}
\def\uzh@supraise{0.375}
\newlength{\uzh@supem}
\newlength{\uzh@supsize}
\DeclareRobustCommand{\uzhsup}[1]{%
  \setlength{\uzh@supem}{\dimexpr\f@size pt\relax}%
  \setlength{\uzh@supsize}{\uzh@supscale\uzh@supem}%
  \raisebox{\uzh@supraise\uzh@supem}{%
    \fontsize{\uzh@supsize}{\uzh@supsize}\selectfont#1}%
}

% In-text citation marks are pointers, not content. \uzhtinycites (opt-in,
% call it once in the preamble) prints them small, raised and grey, so they
% stop competing with the words:
%   \uzhtinycites
% The reference list keeps the normal size, because \cite is not used inside
% it. uzh@grey3 is the palette shade closest to a 65% grey.
\newcommand{\uzhtinycites}{%
  \let\uzh@origcite\cite
  \renewcommand{\cite}[1]{%
    \raisebox{0.5ex}{\tiny\textcolor{uzh@grey3}{\uzh@origcite{##1}}}}%
}

% Tighter space around displayed formulas, for a column or a slide that holds
% more than one display and would otherwise run past the bottom:
%   \uzhtightmath{3pt}{6pt}      above, below
% The short skips -- used when the display follows a short line -- follow at
% two thirds of the two values. \dagtightmath (uzhdag) is the DAG-slide preset.
\newcommand{\uzhtightmath}[2]{%
  \setlength{\abovedisplayskip}{#1}%
  \setlength{\belowdisplayskip}{#2}%
  \setlength{\abovedisplayshortskip}{0.667\abovedisplayskip}%
  \setlength{\belowdisplayshortskip}{0.667\belowdisplayskip}%
}

\newlength{\uzh@oW}
\newlength{\uzh@oH}
\newlength{\uzh@rW}
\newlength{\uzh@rH}
\newlength{\uzh@cWH}
\newcommand\fillimage[4][]{% width, height, image
  \settototalheight{\uzh@oH}{\includegraphics{#4}}%
  \settowidth{\uzh@oW}{\includegraphics{#4}}%
  \setlength{\uzh@rW}{\uzh@oW * \ratio{#3}{\uzh@oH}}%
  \ifthenelse{\lengthtest{\uzh@rW < #2}}{%
    % image too high -> clip height
    \setlength{\uzh@rH}{\uzh@oH * \ratio{#2}{\uzh@oW}}%
    \setlength{\uzh@cWH}{(\uzh@rH-#3) * \ratio{\uzh@oW}{#2} * \ratio{1cm}{2cm}}%
    \includegraphics[width=#2,clip,trim=0 \uzh@cWH{} 0 \uzh@cWH{},#1]{#4}%
  }{%
    % image too wide -> clip width
    \setlength{\uzh@cWH}{(\uzh@rW-#2) * \ratio{\uzh@oH}{#3} * \ratio{1cm}{2cm}}%
    \includegraphics[height=#3,clip,trim=\uzh@cWH{} 0 \uzh@cWH{} 0,#1]{#4}%
  }%
}

\newcommand{\imagecard}[4][3cm]{% [height], image, title, subtitle
  \fillimage{\textwidth}{#1}{#2}
  \scriptsize
  \strut\textbf{#3} \\
  \strut#4%
  \vskip0.19cm%
}

% A big white number on a full-bleed I-Math grey panel (the same grey as the
% navigation-bar separator line, uzh@imathgrey). The panel bleeds to the left,
% right and bottom page edges. Use it as the only content of a top-aligned,
% title-less frame:
%   \begin{frame}[t]\numberoverlay{42}\end{frame}
%
% Beamer starts the frame body a fixed distance below the navigation separator
% (its head-to-body gap). That gap is the same whether the separator is the thin
% grey rule -- no subsection -- or the taller grey subsection band, so raising
% the panel's top edge by that one constant closes the white strip in both
% states. \uzh@navsepgap holds it; it is a hair more than the measured gap so the
% panel top laps a fraction into the grey separator (same colour) for a seamless
% join, while staying well clear of the mini-frame dots above.
\newlength{\uzh@navsepgap}\setlength{\uzh@navsepgap}{7.5pt}
\newlength{\uzh@paneltop}
\newcommand{\numberoverlay}[1]{% content
  \noindent
  % Top edge of the panel: the top of the text area (y=\textheight in local
  % coordinates, where TeX clamps the tall bounding box) raised by the gap so it
  % meets the navigation separator.
  \setlength{\uzh@paneltop}{\textheight}%
  \addtolength{\uzh@paneltop}{\uzh@navsepgap}%
  \begin{tikzpicture}[remember picture]
    % The bounding box is as tall as the text area; being far taller than
    % \topskip, TeX clamps it flush to the top of the text area. Fill from the
    % raised top edge down to the page's bottom, bleeding to the page's sides.
    \useasboundingbox (0,0) rectangle (\linewidth,\textheight);
    \fill[overlay,uzh@imathgrey]
      (current page.west |- 0,\uzh@paneltop) rectangle (current page.south east);
    \node[overlay,anchor=north east,text=white,inner sep=0.4cm]
      at (current page.east |- 0,\uzh@paneltop)
      {\fontsize{200}{200}\selectfont\textbf{#1}};
  \end{tikzpicture}%
}
