# Makefile for the UZH beamer presentation template
# Builds every top-level *.tex document to PDF with latexmk + pdflatex.
# latexmk resolves reruns and calls bibtex for ref.bib automatically.

# The *-draft.tex and *-frames.tex driver files are generated by the targets
# below, so they must not be picked up as documents in their own right.
TEX = $(filter-out %-draft.tex %-frames.tex,$(wildcard *.tex))
PDF = $(patsubst %.tex,%.pdf,$(TEX))

# A PDF is stale whenever the theme, the bibliography or an image changes, not
# only when its own .tex does. Without these prerequisites make reports
# "Nothing to be done" after a .sty edit and the PDF silently stays out of date.
DEPS = $(wildcard *.sty) $(wildcard *.bib) $(wildcard img/*)

LATEXMK      = latexmk
PDFLATEX     = pdflatex -interaction=nonstopmode -synctex=1
LATEXMKFLAGS = -pdf -pdflatex="$(PDFLATEX)" -halt-on-error

.PHONY: all pdf draft watch watch-draft clean cleanall
.SUFFIXES: .tex .pdf

all: pdf

pdf: $(PDF)

# Pattern rule: each PDF depends on its source and on the shared style files.
# latexmk decides how many pdflatex passes are actually needed (and exits in
# ~0.1s when nothing changed), so re-entering it on every make is cheap.
%.pdf: %.tex $(DEPS)
	$(LATEXMK) $(LATEXMKFLAGS) $<

# --- Fast draft builds -------------------------------------------------------
# The section navigation bar is re-typeset on every slide and accounts for
# roughly two thirds of each pdflatex pass. A draft build suppresses it, cutting
# a one-line rebuild from ~3.7s to ~1.5s. Everything below the header is
# unchanged, so this is for iterating on content; run `make` before presenting.
#
# The generated <doc>-draft.tex is a thin driver with its own .aux files, so
# draft and final builds never invalidate each other.
DRAFT    = $(patsubst %.tex,%-draft.tex,$(TEX))
DRAFTPDF = $(patsubst %.tex,%-draft.pdf,$(TEX))

draft: $(DRAFTPDF)

%-draft.tex: %.tex
	@printf '%%%% Generated by `make draft` -- do not edit, do not commit.\n' > $@
	@printf '\\AtBeginDocument{\\setbeamertemplate{headline}{}}\n' >> $@
	@printf '\\input{$<}\n' >> $@

%-draft.pdf: %-draft.tex %.tex $(DEPS)
	$(LATEXMK) $(LATEXMKFLAGS) $<

.PRECIOUS: %-draft.tex

# --- Single-frame preview ----------------------------------------------------
# beamer's own \includeonlyframes: typeset only the frames you are working on.
# Tag them with a label -- \begin{frame}[label=math]{Mathematics} -- then
#
#     make frames FRAMES=math,tables
#
# ~0.75s regardless of how long the deck is, because unselected frames are
# skipped entirely. The output is those frames only, with the navigation bar
# suppressed and the footer slide numbers therefore meaningless; it is a preview
# of one slide's layout, not the deck. Run `make` for the real thing.
FRAMES ?=

.PHONY: frames
frames:
ifeq ($(strip $(FRAMES)),)
	$(error set FRAMES to one or more frame labels, e.g. make frames FRAMES=math,tables)
endif
	@printf '%%%% Generated by `make frames` -- do not edit, do not commit.\n' > $(FRAMESTEX)
	@printf '\\AtBeginDocument{\\includeonlyframes{$(FRAMES)}\\setbeamertemplate{headline}{}}\n' >> $(FRAMESTEX)
	@printf '\\input{$(firstword $(TEX))}\n' >> $(FRAMESTEX)
	$(LATEXMK) $(LATEXMKFLAGS) $(FRAMESTEX)

FRAMESTEX = $(patsubst %.tex,%-frames.tex,$(firstword $(TEX)))

# --- Continuous preview ------------------------------------------------------
# Rebuild on save (Ctrl-C to stop). This is the fastest edit loop: latexmk stays
# resident, watches every dependency it recorded, and rebuilds on each save.
watch:
	$(LATEXMK) $(LATEXMKFLAGS) -pvc $(TEX)

# Same loop, against the draft build.
watch-draft: $(DRAFT)
	$(LATEXMK) $(LATEXMKFLAGS) -pvc $(DRAFT)

# Remove build artifacts but keep the PDFs.
clean:
	$(LATEXMK) -c
	rm -f *~ *.nav *.snm *.vrb *.bbl *.blg *.backup Rplots.pdf
	rm -f $(patsubst %.tex,%-draft.*,$(TEX)) $(patsubst %.tex,%-frames.*,$(TEX))

# Remove build artifacts and the generated PDFs.
cleanall:
	$(LATEXMK) -C
	rm -f *~ *.nav *.snm *.vrb *.bbl *.blg *.backup Rplots.pdf $(PDF)
	rm -f $(patsubst %.tex,%-draft.*,$(TEX)) $(patsubst %.tex,%-frames.*,$(TEX))
