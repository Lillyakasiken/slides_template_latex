\RequirePackage{uzhsetup}

\mode<presentation>

\setbeamersize{text margin left=0.4cm,text margin right=0.4cm}

\defbeamertemplate*{frametitle}{uzh}[1][left]{
  \begin{beamercolorbox}[#1]{frametitle}
    \usebeamerfont{frametitle}%
    \vbox{}\vskip0.15cm%
    \strut\insertframetitle\strut\par%
    {%
      \ifx\insertframesubtitle\@empty%
      \else%
      {\usebeamerfont{framesubtitle}\usebeamercolor[fg]{framesubtitle}\strut\insertframesubtitle\strut\par}%
      \fi
    }%
  \end{beamercolorbox}%
}

\defbeamertemplate{headline}{uzhlogo}{
  \begin{beamercolorbox}[sep=0.4cm]{headline}
    \raisebox{-0.43\height}{\includegraphics[width=2.2cm]{img/uzh-logo.pdf}}%
    \ifx\insertinstitute\@empty%
    \else%
      \hskip0.4cm{\color{gray}\vrule}\hskip0.4cm%
      \begin{minipage}{5cm}%
        \raggedright
        \textsb{\insertinstitute}%
      \end{minipage}%
    \fi%
  \end{beamercolorbox}
}

\def\ps@navigation@titlepage{%
  \setbeamertemplate{footline}{}
  \setbeamertemplate{headline}[uzhlogo]
  \@nameuse{ps@navigation}
}

\defbeamertemplate*{footline}{uzh}{
  \vskip0.2cm
  \begin{beamercolorbox}[sep=0.4cm]{footline}
    \usebeamerfont{footline}\usebeamercolor[fg]{footline}\textsb{\uzh@uzh}%
    \ifx\insertinstitute\@empty%
    \else%
      \hskip2ex|\hskip2ex\insertinstitute%
    \fi%
    \hfill%
    \insertdate\hskip2ex|\hskip2ex\insertframenumber\,/\,\inserttotalframenumber%
  \end{beamercolorbox}
}

\defbeamertemplate*{navigation symbols}{uzh}{}

% --- Top navigation bar ----------------------------------------------------
% A white section bar (mini-frame progress dots + section names) tops every
% slide and is closed off from the body by a thin horizontal rule in the I-Math
% grey (uzh@imathgrey) -- the same blue-tinted grey as the line under the header
% of the official UZH Institute of Mathematics template. Frames that sit
% directly under a section (no subsection) get just that grey line. When the
% current frame lives inside a subsection, the separator instead becomes an
% I-Math grey band carrying the subsection title in white (a slightly larger
% font, see beamerthemeuzh.sty). Either way the navigation area is always cut
% from the slide body by the same grey.

% Thin I-Math grey separator rule under the navigation bar, edge to edge. The
% colour is taken from the subsection band's background so the line and the band
% stay in lock-step from a single definition.
\newcommand{\uzh@navline}{%
  \nointerlineskip%
  {\usebeamercolor{subsection in head/foot}%
    \color{subsection in head/foot.bg}%
    \rule{\paperwidth}{0.8pt}}%
  \par%
}

\defbeamertemplate*{headline}{uzh}{%
  \begin{beamercolorbox}[wd=\paperwidth,ht=2.25ex,dp=2.5ex]{section in head/foot}%
    \insertnavigation{\paperwidth}%
  \end{beamercolorbox}%
  \ifx\insertsubsectionhead\@empty%
    \uzh@navline%
  \else%
    \begin{beamercolorbox}[wd=\paperwidth,ht=3ex,dp=1.75ex,%
      leftskip=.3cm,rightskip=.3cm plus1fil]{subsection in head/foot}%
      \usebeamerfont{subsection in head/foot}%
      \usebeamertemplate{subsection in head/foot}%
    \end{beamercolorbox}%
  \fi%
}

\mode
<all>
